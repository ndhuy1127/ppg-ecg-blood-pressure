# Text console on UART0 only; the native USB Serial/JTAG port carries packets.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# 1 ms ticks for queue and USB write timeouts.
CONFIG_FREERTOS_HZ=1000
# SAMP capture (Packet Schema V0.2 section 7.1): the MCPWM ISR and its data in
# internal memory, so a flash operation cannot delay an edge.
CONFIG_MCPWM_ISR_CACHE_SAFE=y
